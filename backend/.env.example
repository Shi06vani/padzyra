NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=padzyra
DB_USER=postgres
# Password chosen when PostgreSQL was installed.
DB_PASSWORD=shivani@postgress
DB_LOGGING=false
DB_SSL=false

# Encrypts cycle notes and session secrets. Set a long random value in production.
APP_SECRET=padzyra-super-secret-key-for-girl-health-data-safety
TZ_NAME=Asia/Kolkata

# ========================================================
# 1. EMAIL OTP & ALERTS VIA SMTP (Nodemailer)
# ========================================================
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character App Password (not normal password)
# For Hostinger/Zoho/Custom: Use your host's SMTP credentials
# If left commented in dev mode, OTP codes are logged to console and written to tmp/last-otp.txt
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shivanisuryavanshi612@gmail.com
SMTP_PASS=axhi bnbk iqbr ddfo
SMTP_FROM="Padzyra Care" <shivanisuryavanshi612@gmail.com>

# ========================================================
# 2. PUSH NOTIFICATIONS & PHONE AUTH VIA FIREBASE (FCM)
# ========================================================
# Option A: Path to serviceAccountKey.json downloaded from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Direct credentials (useful for cloud deploys like Render/Vercel/Heroku)
# FIREBASE_PROJECT_ID=padzyra-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@padzyra-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========================================================
# 3. WEB PUSH (VAPID) FALLBACK (Optional)
# ========================================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:reminders@padzyra.local

# Optional. When set in production, Sequelize uses this instead of the DB fields above.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/padzyra

# ========================================================
# 4. EVIDENCE-BASED AI PERIOD COMPANION
# ========================================================
# Provider choices: 'gemini' | 'openai' | 'clinical_engine'
# If no external API key is provided, Padzyra automatically and safely uses
# the internal clinical engine grounded in reviewed WHO, NHS, and ACOG literature.
AI_PROVIDER=clinical_engine
GEMINI_API_KEY=
OPENAI_API_KEY=

